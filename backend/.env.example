# ============================================================
# Enterprise Data Acquisition Platform — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ──────────────────────────────────────
# SUPABASE (Required — all services)
# ──────────────────────────────────────
# Find these in Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Find in Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Find in Supabase Dashboard → Settings → Database → Connection string (JDBC)
SUPABASE_JDBC_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# ──────────────────────────────────────
# SERVICE URLS (Local development)
# ──────────────────────────────────────
IDENTITY_SERVICE_URL=http://localhost:8081
ORGANIZATION_SERVICE_URL=http://localhost:8082
SCRAPER_CONFIG_SERVICE_URL=http://localhost:8083
EXECUTION_ENGINE_URL=http://localhost:8084
BROWSER_SERVICE_URL=http://localhost:8085
DATA_PIPELINE_SERVICE_URL=http://localhost:8086
SCHEDULER_SERVICE_URL=http://localhost:8087

# ──────────────────────────────────────
# FRONTEND (Angular)
# ──────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ──────────────────────────────────────
# CLOUDFLARE (Production deployment)
# ──────────────────────────────────────
# The Angular build (dist/) is deployed to Cloudflare Pages
# The Java backend is deployed to Railway/Render/VPS
API_BASE_URL=https://your-backend.railway.app

# ──────────────────────────────────────
# PLAYWRIGHT (Browser Service)
# ──────────────────────────────────────
# Maximum concurrent browser sessions
BROWSER_POOL_MAX_SIZE=20
# Headless mode (true in production, false for local debugging)
BROWSER_HEADLESS=true
